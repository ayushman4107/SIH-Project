{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visiops.local/schemas/finding.schema.json",
  "title": "VisiopsFinding",
  "type": "object",
  "additionalProperties": false,
  "required": ["finding_id", "finding_type", "pillar", "affected_asset", "severity", "raw_score", "decision_threshold", "confidence", "confidence_normalizer", "calibration_status", "human_readable_reason", "evidence", "method", "recommended_disposition"],
  "properties": {
    "finding_id": {"type": "string", "format": "uuid"},
    "finding_type": {"type": "string", "enum": ["label_error", "near_duplicate", "statistical_outlier", "source_concentration", "weight_spectral_anomaly", "non_finite_weight", "provenance_tampered", "provenance_reordered", "provenance_deleted", "provenance_unsigned", "ood_sample", "possible_drift", "suspicious_entropy_shift", "engine_error", "malformed_input", "activation_cluster_anomaly", "gradient_misalignment", "influence_systematic_mislabel", "orthogonal_drift_anomaly", "natural_covariate_drift"]},
    "pillar": {"type": "string", "enum": ["F1", "F2", "F3", "F4", "F5"]},
    "affected_asset": {
      "type": "object", "additionalProperties": false,
      "required": ["subject_type", "subject_id"],
      "properties": {
        "subject_type": {"type": "string", "enum": ["training_sample", "candidate_model", "inference"]},
        "subject_id": {"type": "string", "minLength": 1},
        "sample_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "source_id": {"type": ["string", "null"]},
        "layer_name": {"type": ["string", "null"]},
        "artifact_ref": {"type": ["string", "null"]}
      }
    },
    "severity": {"type": "string", "enum": ["informational", "low", "medium", "high", "critical"]},
    "raw_score": {"type": ["number", "integer", "null"]},
    "decision_threshold": {"type": ["number", "integer", "string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence_normalizer": {"type": "string", "minLength": 1},
    "calibration_status": {"const": "uncalibrated"},
    "human_readable_reason": {"type": "string", "minLength": 1},
    "evidence": {"type": "object"},
    "method": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "parameters_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "recommended_disposition": {"type": "string", "enum": ["accept", "review", "quarantine"]}
  },
  "allOf": [
    {
      "if": {"properties": {"pillar": {"const": "F1"}}},
      "then": {
        "properties": {
          "evidence": {
            "type": "object",
            "anyOf": [
              {"required": ["pairs"]},
              {"required": ["percentile"]},
              {"required": ["syndicate"]},
              {"required": ["objectness"]},
              {"required": ["global_5th"]},
              {"required": ["mid_freq_energy"]},
              {"required": ["bipartite_cost"]},
              {"required": ["block_size"]}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"pillar": {"const": "F2"}}},
      "then": {
        "properties": {
          "evidence": {
            "type": "object",
            "anyOf": [
              {"required": ["architecture_id"]},
              {"required": ["worst_layer"]},
              {"required": ["score"]},
              {"required": ["snr"]},
              {"required": ["divergence"]}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"pillar": {"const": "F4"}}},
      "then": {
        "properties": {
          "evidence": {
            "type": "object",
            "anyOf": [
              {"required": ["copula_risk"]},
              {"required": ["model_dependency"]},
              {"required": ["fallback_active"]}
            ]
          }
        }
      }
    }
  ]
}
